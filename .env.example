# Salin file ini jadi .env lalu isi nilai di bawah.

# Kredensial dari dashboard Tripay (menu Merchant)
TRIPAY_API_KEY=isi_api_key
TRIPAY_PRIVATE_KEY=isi_private_key
TRIPAY_MERCHANT_CODE=isi_merchant_code

# "sandbox" untuk uji coba, "production" kalau sudah siap terima uang asli
TRIPAY_MODE=sandbox

# Password untuk masuk dashboard admin (/dashboard.html)
ADMIN_PASSWORD=syanastore2026

# URL publik server kamu (dipakai Tripay untuk kirim webhook & tombol kembali).
# Waktu testing lokal, isi dengan URL ngrok. Setelah deploy, isi domain asli.
BASE_URL=http://localhost:3000

PORT=3000
